{
  "name": "@shinobi/sim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "sim": "tsx src/cli.ts",
    "test": "vitest run --passWithNoTests",
    "test:speed": "vitest run --mode speed --no-file-parallelism -t @speed",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@shinobi/content": "workspace:*",
    "@shinobi/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  }
}
